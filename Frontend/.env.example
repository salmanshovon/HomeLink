# HomeLink Frontend — environment variables
# Copy to .env and fill in values. Never commit your real .env file.

# Base URL for the Django REST API.
# Leave empty in development to use the Vite proxy (requests go to /api/...).
# In production, set to the deployed API origin, e.g.:
# VITE_API_BASE_URL=https://api.homelink.com.bd/api/v1
VITE_API_BASE_URL=

# Public site URL (used for canonical links and share targets).
VITE_PUBLIC_SITE_URL=https://homelink.com.bd

# Enable React Query devtools in development.
VITE_ENABLE_QUERY_DEVTOOLS=true
